local function selectTab(name)
	for tabName, data in pairs(tabs) do
		local selected = tabName == name

		pages[tabName].Visible = selected

		tween(data.Label, .2, {
			TextColor3 = selected and BG or MUTED
		}):Play()
	end

	local button = tabs[name].Button

	tween(
		activePill,
		.35,
		{
			Position = UDim2.fromOffset(
				button.Position.X.Offset,
				button.Position.Y.Offset
			)
		},
		Enum.EasingStyle.Quart
	):Play()
end

for name, data in pairs(tabs) do
	data.Button.MouseEnter:Connect(function()
		if not pages[name].Visible then
			tween(data.Label, .15, {
				TextColor3 = WHITE
			}):Play()
		end
	end)

	data.Button.MouseLeave:Connect(function()
		if not pages[name].Visible then
			tween(data.Label, .15, {
				TextColor3 = MUTED
			}):Play()
		end
	end)

	data.Button.MouseButton1Click:Connect(function()
		selectTab(name)
	end)
end


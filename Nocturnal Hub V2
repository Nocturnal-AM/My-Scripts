local popupToken = 0

local function hidePopup()
	if not popup.Visible then
		return
	end

	popupToken += 1

	tween(
		popup,
		.22,
		{
			Position = UDim2.new(1, -20, 1, 65),
			BackgroundTransparency = 1
		},
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.In
	):Play()

	tween(popupStroke, .18, {
		Transparency = 1
	}):Play()

	tween(popupText, .18, {
		TextTransparency = 1
	}):Play()

	task.delay(.25, function()
		if popup.Visible then
			popup.Visible = false
		end
	end)
end

function showPopup(text)
	popupToken += 1
	local token = popupToken

	popupText.Text = text
	popup.Visible = true
	popup.Position = UDim2.new(1, -20, 1, 65)
	popup.BackgroundTransparency = 1
	popupStroke.Transparency = 1
	popupText.TextTransparency = 1

	tween(
		popup,
		.3,
		{
			Position = UDim2.new(1, -20, 1, -20),
			BackgroundTransparency = 0
		},
		Enum.EasingStyle.Back
	):Play()

	tween(popupStroke, .25, {
		Transparency = .35
	}):Play()

	tween(popupText, .25, {
		TextTransparency = 0
	}):Play()

	task.delay(2, function()
		if token == popupToken and popup.Visible then
			hidePopup()
		end
	end)
end

-- State

local minimized = false
local animating = false
local destroyed = false

-- Minimize

local function minimizeHub()
	if minimized or animating or destroyed then
		return
	end

	animating = true
	minimized = true

	local target = UDim2.new(
		main.Position.X.Scale,
		main.Position.X.Offset,
		1,
		30
	)

	tween(
		main,
		.4,
		{
			Position = target,
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1
		},
		Enum.EasingStyle.Back,
		Enum.EasingDirection.In
	):Play()

	tween(mainStroke, .3, {
		Transparency = 1
	}):Play()

	task.wait(.42)

	if destroyed then
		return
	end

	main.Visible = false
	animating = false

	showPopup("Right Alt to open script again")
end

-- Close

local function closeHub()
	if animating or destroyed then
		return
	end

	animating = true
	destroyed = true

	showPopup("bye bye :D")

	local closeTween = tween(
		main,
		.45,
		{
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1
		},
		Enum.EasingStyle.Back,
		Enum.EasingDirection.In
	)

	closeTween:Play()

	tween(mainStroke, .35, {
		Transparency = 1
	}):Play()

	for _, descendant in ipairs(main:GetDescendants()) do
		if descendant:IsA("TextLabel")
			or descendant:IsA("TextButton") then

			tween(descendant, .25, {
				TextTransparency = 1
			}):Play()

		elseif descendant:IsA("ImageLabel") then

			tween(descendant, .25, {
				ImageTransparency = 1
			}):Play()

		elseif descendant:IsA("Frame")
			and descendant ~= main then

			tween(descendant, .25, {
				BackgroundTransparency = 1
			}):Play()
		end
	end

	closeTween.Completed:Wait()
	task.wait(1)

	if gui and gui.Parent then
		gui:Destroy()
	end
end

minimize.MouseButton1Click:Connect(minimizeHub)
close.MouseButton1Click:Connect(closeHub)

-- Restore

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or destroyed then
		return
	end

	if input.KeyCode ~= Enum.KeyCode.RightAlt then
		return
	end

	if not minimized or animating then
		return
	end

	animating = true
	hidePopup()

	main.Visible = true

	main.Position = UDim2.new(
		main.Position.X.Scale,
		main.Position.X.Offset,
		1,
		30
	)

	main.Size = UDim2.fromOffset(20, 20)
	main.BackgroundTransparency = 1
	mainStroke.Transparency = 1

	for _, descendant in ipairs(main:GetDescendants()) do
		if descendant:IsA("TextLabel")
			or descendant:IsA("TextButton") then

			descendant.TextTransparency = 0

		elseif descendant:IsA("ImageLabel") then

			descendant.ImageTransparency = 0

		elseif descendant:IsA("Frame")
			and descendant ~= main then

			if descendant == activePill then
				descendant.BackgroundTransparency = 0
			elseif descendant == sidebar then
				descendant.BackgroundTransparency = .25
			elseif descendant == content then
				descendant.BackgroundTransparency = 1
			else
				descendant.BackgroundTransparency = 0
			end
		end
	end

	tween(
		main,
		.45,
		{
			Position = UDim2.fromScale(.5, .5),
			Size = MAIN_SIZE,
			BackgroundTransparency = .02
		},
		Enum.EasingStyle.Back
	):Play()

	tween(mainStroke, .35, {
		Transparency = .35
	}):Play()

	task.wait(.46)

	minimized = false
	animating = false
end)


-- State

local minimized = false
local animating = false

local function hidePopup(popup, stroke, label)
	tween(
		popup,
		0.22,
		{
			Position = UDim2.new(1, -20, 1, 60),
			BackgroundTransparency = 1
		},
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.In
	):Play()

	tween(stroke, 0.18, {
		Transparency = 1
	}):Play()

	tween(label, 0.18, {
		TextTransparency = 1
	}):Play()
end

local function showPopup(popup, stroke, label, duration)
	popup.Position = UDim2.new(1, -20, 1, 60)

	tween(
		popup,
		0.3,
		{
			Position = UDim2.new(1, -20, 1, -20),
			BackgroundTransparency = 0
		},
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	):Play()

	tween(stroke, 0.25, {
		Transparency = 0.35
	}):Play()

	tween(label, 0.25, {
		TextTransparency = 0
	}):Play()

	if duration then
		task.delay(duration, function()
			if popup.Parent then
				hidePopup(popup, stroke, label)
			end
		end)
	end
end


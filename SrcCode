local function createButton(data, index)
    local button = Instance.new("TextButton")
    button.Name = data.Name
    button.Size = UDim2.new(1, -36, 0, 43)
    button.Position = UDim2.fromOffset(18, 72 + ((index - 1) * 52))
    button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    button.BackgroundTransparency = 0.91
    button.BorderSizePixel = 0
    button.Text = data.Name
    button.TextColor3 = Color3.fromRGB(235, 235, 240)
    button.TextSize = 13
    button.Font = Enum.Font.Gotham
    button.AutoButtonColor = false
    button.Parent = main

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 11)
    corner.Parent = button

    local buttonStroke = Instance.new("UIStroke")
    buttonStroke.Color = Color3.fromRGB(255, 255, 255)
    buttonStroke.Transparency = 0.9
    buttonStroke.Thickness = 1
    buttonStroke.Parent = button

    local normalSize = UDim2.new(1, -36, 0, 43)
    local hoverSize = UDim2.new(1, -28, 0, 47)
    local normalPos = button.Position
    local hoverPos = UDim2.new(
        normalPos.X.Scale,
        normalPos.X.Offset - 4,
        normalPos.Y.Scale,
        normalPos.Y.Offset - 2
    )

    button.MouseEnter:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {
                Size = hoverSize,
                Position = hoverPos,
                BackgroundTransparency = 0.82
            }
        ):Play()

        TweenService:Create(
            buttonStroke,
            TweenInfo.new(0.16, Enum.EasingStyle.Quint),
            {
                Transparency = 0.65
            }
        ):Play()
    end)

    button.MouseLeave:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {
                Size = normalSize,
                Position = normalPos,
                BackgroundTransparency = 0.91
            }
        ):Play()

        TweenService:Create(
            buttonStroke,
            TweenInfo.new(0.18, Enum.EasingStyle.Quint),
            {
                Transparency = 0.9
            }
        ):Play()
    end)

    button.MouseButton1Click:Connect(function()
        task.spawn(function()
            loadstring(game:HttpGet(data.URL))()
        end)
    end)

    return button
end


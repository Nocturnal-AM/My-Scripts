-- Minimize

local function minimizeUI()
	if minimized or animating then
		return
	end

	animating = true
	minimized = true

	local sizeTween = tween(
		main,
		0.32,
		{
			Size = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1
		},
		Enum.EasingStyle.Back,
		Enum.EasingDirection.In
	)

	tween(mainStroke, 0.25, {
		Transparency = 1
	}):Play()

	sizeTween:Play()
	sizeTween.Completed:Wait()

	animating = false

	showPopup(
		restorePopup,
		restoreStroke,
		restoreText,
		2
	)
end

-- Restore

local function restoreUI()
	if not minimized or animating then
		return
	end

	animating = true

	hidePopup(
		restorePopup,
		restoreStroke,
		restoreText
	)

	main.Size = UDim2.fromOffset(0, 0)
	main.BackgroundTransparency = 1
	mainStroke.Transparency = 1

	local sizeTween = tween(
		main,
		0.4,
		{
			Size = MAIN_SIZE,
			BackgroundTransparency = 0.05
		},
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	)

	tween(mainStroke, 0.35, {
		Transparency = 0.45
	}):Play()

	sizeTween:Play()
	sizeTween.Completed:Wait()

	minimized = false
	animating = false
end

